# ==========================================
# TransFleet Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Database Configuration (For Local XAMPP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=transfleet_db

# Cloud Database Configuration (TiDB Cloud / Aiven / Railway / PlanetScale)
# Set DB_SSL=true if using a cloud MySQL provider
DB_SSL=false

# Alternatively, you can provide a full DATABASE_URL connection string:
# DATABASE_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/transfleet_db?ssl={"rejectUnauthorized":true}

# JWT Secret & Expiry
JWT_SECRET=transfleet_super_secret_jwt_key_2026_fsd
JWT_EXPIRE=7d
